# Write the build's identity into a generated header, and only touch the file when it changes so
# a rebuild does not recompile the world.
#
# Run at build time rather than configure time: a configure-time value goes stale the moment you
# commit, and the number this produces is the one a bench session uses to tell two flashed units
# apart. `--dirty` is the point of it -- it says the image came from uncommitted work.
#
# Expects SOURCE_DIR and OUTPUT to be passed with -D.

execute_process(
  COMMAND git -C "${SOURCE_DIR}" describe --always --dirty --tags
  OUTPUT_VARIABLE FW_VERSION
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE GIT_RESULT
  )
if(NOT GIT_RESULT EQUAL 0 OR FW_VERSION STREQUAL "")
  set(FW_VERSION "unknown")
endif()

# DAP_GetProductFirmwareVersionString documents a 60 character buffer.
string(SUBSTRING "${FW_VERSION}" 0 59 FW_VERSION)

set(CONTENT "/* Generated by cmake/fw_version.cmake. Do not edit. */\n")
string(APPEND CONTENT "#ifndef FW_VERSION_H\n#define FW_VERSION_H\n\n")
string(APPEND CONTENT "#define FIRMWARE_VERSION \"${FW_VERSION}\"\n\n#endif\n")

set(EXISTING "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" EXISTING)
endif()
if(NOT EXISTING STREQUAL CONTENT)
  file(WRITE "${OUTPUT}" "${CONTENT}")
  message(STATUS "firmware version: ${FW_VERSION}")
endif()
