+// Generate OScan1 Frame: nTDI, TMS and TDO packets
+//   tms:    TMS value
+//   tdi:    TDI value
+//   return: TDO value
+static uint32_t OScan1_Frame (uint32_t tms, uint32_t tdi) {
+  uint32_t tdo;
+
+  PIN_SWDIO_OUT((tdi & 1U) ^ 1U);           // nTDI
+  PIN_DELAY();
+  PIN_TCK_SET();
+  PIN_DELAY();
+  PIN_TCK_CLR();
+  CJTAG_QUARTER_DELAY();
+  PIN_SWDIO_OUT(tms & 1U);                  // TMS
+  CJTAG_QUARTER_DELAY();
+  PIN_SWDIO_OUT_DISABLE();                  // Release TMSC (14.2.3)
+  PIN_TCK_SET();
+  PIN_DELAY();
+  PIN_TCK_CLR();                            // TDO
+  PIN_DELAY();
+  tdo = PIN_SWDIO_IN();
+  PIN_TCK_SET();
+  PIN_DELAY();
+  PIN_TCK_CLR();
+  PIN_SWDIO_OUT_ENABLE();
+
+  return (tdo);
+}
 
